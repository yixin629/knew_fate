<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="KnewFate.Controls.FloatingAIAssistantButton"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:KnewFate.Views">

    <!-- Floating AI Assistant Button - Mimicking WeChat, Alipay and other mainstream apps -->
    <Grid>
        <!-- Background overlay (when chat window is open) -->
        <BoxView x:Name="BackgroundOverlay"
                 BackgroundColor="Black"
                 Opacity="0"
                 IsVisible="False"
                 InputTransparent="True" />

        <!-- Chat window container -->
        <Border x:Name="ChatContainer"
                BackgroundColor="White"
                IsVisible="False"
                Margin="20,0,20,100"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                HeightRequest="500">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,20,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Offset="0,5" Radius="15" />
            </Border.Shadow>

            <Grid RowDefinitions="60,*,70">
                <!-- Chat window header -->
                <Border Grid.Row="0" 
                        BackgroundColor="{DynamicResource Primary}"
                        Padding="20,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20,20,0,0" />
                    </Border.StrokeShape>
                    
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="🔮"
                               FontSize="20"
                               VerticalOptions="Center" />
                        
                        <StackLayout Grid.Column="1" 
                                   Orientation="Vertical"
                                   Margin="10,0,0,0">
                            <Label Text="{Binding Source={x:Static views:LocalizationHelper.Instance}, Path=[AIAssistant]}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label x:Name="StatusLabel"
                                   Text="{Binding Source={x:Static views:LocalizationHelper.Instance}, Path=[AIConnecting]}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9" />
                        </StackLayout>
                        
                        <Button Grid.Column="2"
                                Text="✕"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                Clicked="OnCloseChatClicked">
                        </Button>
                    </Grid>
                </Border>

                <!-- Chat messages area -->
                <ScrollView x:Name="ChatScrollView" Grid.Row="1" Padding="15,10">
                    <StackLayout x:Name="MessagesContainer" Spacing="10">
                        <!-- Welcome message -->
                        <Border BackgroundColor="{DynamicResource Gray100}" Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15,15,15,5" />
                            </Border.StrokeShape>
                            <StackLayout>
                                <Label Text="{Binding Source={x:Static views:LocalizationHelper.Instance}, Path=[AIAssistantWelcome]}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource Primary}" />
                                <Label Text="{Binding Source={x:Static views:LocalizationHelper.Instance}, Path=[HowCanIHelp]}"
                                       FontSize="13"
                                       TextColor="{DynamicResource Gray700}"
                                       LineBreakMode="WordWrap"
                                       Margin="0,5,0,0" />
                            </StackLayout>
                        </Border>

                        <!-- Quick question buttons -->
                        <CollectionView x:Name="QuickQuestionsView"
                                       HeightRequest="110"
                                       Margin="0,5">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{DynamicResource Primary}"
                                           Padding="12,8"
                                           WidthRequest="150">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15" />
                                        </Border.StrokeShape>
                                        
                                        <Label Text="{Binding}"
                                               FontSize="12"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               MaxLines="2"
                                               LineBreakMode="WordWrap" />
                                        
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnQuickQuestionTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Dynamic messages container -->
                        <StackLayout x:Name="DynamicMessagesContainer" Spacing="8" />

                        <!-- Typing indicator -->
                        <StackLayout x:Name="TypingIndicator" 
                                   Orientation="Horizontal" 
                                   IsVisible="False"
                                   Margin="0,5">
                            <Label Text="🔮" FontSize="14" />
                            <Label Text="{Binding Source={x:Static views:LocalizationHelper.Instance}, Path=[AIThinking]}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray600}"
                                   VerticalOptions="Center" />
                            <ActivityIndicator IsRunning="True"
                                             Color="{DynamicResource Primary}"
                                             WidthRequest="16"
                                             HeightRequest="16"
                                             VerticalOptions="Center"
                                             Margin="5,0,0,0" />
                        </StackLayout>
                    </StackLayout>
                </ScrollView>

                <!-- Input area -->
                <Border Grid.Row="2" 
                        BackgroundColor="White"
                        Padding="15,10"
                        Stroke="{DynamicResource Gray200}"
                        StrokeThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="MessageEntry"
                               Grid.Column="0"
                               Placeholder="Type your question..."
                               FontSize="14"
                               VerticalOptions="Center"
                               ReturnType="Send"
                               Completed="OnSendMessageClicked" />
                        
                        <Button Grid.Column="1"
                                x:Name="SendButton"
                                Text="Send"
                                FontSize="13"
                                BackgroundColor="{DynamicResource Primary}"
                                TextColor="White"
                                Padding="15,8"
                                Margin="10,0,0,0"
                                CornerRadius="15"
                                Clicked="OnSendMessageClicked">
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Floating button -->
        <Border x:Name="FloatingButton"
                BackgroundColor="{DynamicResource Primary}"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Offset="0,3" Radius="10" />
            </Border.Shadow>

            <Grid>
                <!-- Main icon -->
                <Label x:Name="MainIcon"
                       Text="🔮"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="White" />

                <!-- Unread message badge -->
                <Border x:Name="UnreadBadge"
                        BackgroundColor="Red"
                        WidthRequest="20"
                        HeightRequest="20"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-5,-5,0"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    
                    <Label x:Name="UnreadCount"
                           Text="1"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Pulse animation -->
                <Ellipse x:Name="PulseRing"
                         Fill="Transparent"
                         Stroke="{DynamicResource Primary}"
                         StrokeThickness="2"
                         WidthRequest="60"
                         HeightRequest="60"
                         Opacity="0.6"
                         IsVisible="False" />
            </Grid>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFloatingButtonTapped" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
