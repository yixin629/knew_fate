<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.AICustomerServiceDashboard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KnewFate.Views"
             Title="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[AICustomerServiceAdmin]}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- 服务状态概览 -->
            <Frame BackgroundColor="{StaticResource Primary}" 
                   CornerRadius="15" 
                   Padding="20">
                <StackLayout>
                    <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[AIServiceStatus]}"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    
                    <Grid ColumnDefinitions="*,*" 
                          RowDefinitions="Auto,Auto,Auto" 
                          Margin="0,15,0,0"
                          RowSpacing="10"
                          ColumnSpacing="15">
                        
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[OnlineStatus]}"
                               TextColor="White"
                               FontSize="14"/>
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[NormalOperation]}"
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>
                        
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ActiveConversations]}"
                               TextColor="White"
                               FontSize="14"/>
                        <Label Grid.Row="1" Grid.Column="1"
                               x:Name="ActiveConversationsLabel"
                               Text="0"
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>
                        
                        <Label Grid.Row="2" Grid.Column="0"
                               Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[AverageResponseTime]}"
                               TextColor="White"
                               FontSize="14"/>
                        <Label Grid.Row="2" Grid.Column="1"
                               x:Name="ResponseTimeLabel"
                               Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[LessThan3Seconds]}"
                               TextColor="White"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- 快速操作 -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="20">
                <StackLayout>
                    <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[QuickActions]}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[BroadcastNotification]}"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnBroadcastMessageClicked"/>
                        
                        <Button Grid.Column="1"
                                Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ViewStatistics]}"
                                BackgroundColor="{StaticResource Tertiary}"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnViewStatsClicked"/>
                    </Grid>
                    
                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[RestartAIService]}"
                            BackgroundColor="Orange"
                            TextColor="White"
                            CornerRadius="10"
                            Margin="0,10,0,0"
                            Clicked="OnRestartServiceClicked"/>
                </StackLayout>
            </Frame>

            <!-- AI模型状态 -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="20">
                <StackLayout>
                    <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[AIModelStatus]}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15"/>
                    
                    <CollectionView x:Name="AIModelsView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" 
                                      Padding="10"
                                      RowSpacing="5">
                                    
                                    <Label Grid.Column="0"
                                           Text="{Binding StatusIcon}"
                                           FontSize="16"
                                           VerticalOptions="Center"/>
                                    
                                    <StackLayout Grid.Column="1" Margin="10,0">
                                        <Label Text="{Binding ModelName}"
                                               FontSize="14"
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}"/>
                                    </StackLayout>
                                    
                                    <Label Grid.Column="2"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           TextColor="{Binding StatusColor}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- 最近消息日志 -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="20">
                <StackLayout>
                    <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[RecentMessageLog]}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,15"/>
                    
                    <CollectionView x:Name="RecentMessagesView"
                                   HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource Gray100}"
                                       Padding="10"
                                       Margin="0,2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <StackLayout>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding UserMessage}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}"/>
                                        </Grid>
                                        <Label Text="{Binding AIResponse}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray700}"
                                               LineBreakMode="TailTruncation"
                                               Margin="10,5,0,0"/>
                                    </StackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>
