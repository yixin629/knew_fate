<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.DiscoveryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnewFate.ViewModels"
             xmlns:models="clr-namespace:KnewFate.Models"
             x:DataType="vm:DiscoveryViewModel"
             Title="发现">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackLayout Grid.Row="0" 
                    Orientation="Horizontal" 
                    Padding="20,10" 
                    BackgroundColor="{DynamicResource Primary}">
            <Label Text="发现缘分" 
                  FontSize="20" 
                  FontAttributes="Bold" 
                  TextColor="White" 
                  HorizontalOptions="Start" />
            
            <Button Text="🔍" 
                   FontSize="18"
                   BackgroundColor="Transparent"
                   TextColor="White"
                   Command="{Binding SearchCommand}"
                   HorizontalOptions="End" />
        </StackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20">
                <!-- Loading Indicator -->
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                 IsRunning="{Binding IsBusy}"
                                 Color="{DynamicResource Primary}"
                                 HeightRequest="50"
                                 Margin="0,20" />

                <!-- Discovery Cards -->
                <CollectionView ItemsSource="{Binding Users}"
                               IsVisible="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                               ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserProfile">
                            <Grid Margin="0,10">
                                <Border BackgroundColor="{DynamicResource Gray100}"
                                       Padding="15"
                                       Margin="5">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Profile Image -->
                                        <Border Grid.Row="0"
                                               BackgroundColor="{DynamicResource Gray300}"
                                               HeightRequest="200">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            
                                            <Image Source="{Binding Avatar}"
                                                  Aspect="AspectFill"
                                                  HeightRequest="200" />
                                        </Border>

                                        <!-- User Info -->
                                        <StackLayout Grid.Row="1" Margin="0,10,0,0">
                                            <Label Text="{Binding DisplayName}"
                                                  FontSize="18"
                                                  FontAttributes="Bold"
                                                  HorizontalOptions="Center" />
                                            
                                            <Label Text="{Binding Age, StringFormat='{0}岁'}"
                                                  FontSize="14"
                                                  TextColor="{DynamicResource Gray600}"
                                                  HorizontalOptions="Center" />
                                        </StackLayout>

                                        <!-- Compatibility Score -->
                                        <Grid Grid.Row="2" Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                              <Label Grid.Column="1"
                                  Text="{Binding CompatibilityScore, StringFormat='匹配度: {0:P0}'}"
                                                  FontSize="16"
                                                  FontAttributes="Bold"
                                                  TextColor="{DynamicResource Primary}"
                                                  HorizontalOptions="Center" />
                                        </Grid>

                                        <!-- Bio -->
                                        <Label Grid.Row="3"
                                              Text="{Binding Bio}"
                                              FontSize="14"
                                              MaxLines="3"
                                              LineBreakMode="TailTruncation"
                                              HorizontalOptions="Center"
                                              Margin="0,5" />

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="4" Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                   Text="❌"
                                                   FontSize="24"
                                                   BackgroundColor="Transparent"
                                                   TextColor="{DynamicResource Gray500}"
                                                   BindingContext="{Binding UserId}"
                                                   Clicked="OnPassClicked" />

                                            <Button Grid.Column="1"
                                                   Text="💖"
                                                   FontSize="24"
                                                   BackgroundColor="Transparent"
                                                   TextColor="Red"
                                                   BindingContext="{Binding UserId}"
                                                   Clicked="OnLikeClicked" />

                                            <Button Grid.Column="2"
                                                   Text="⭐"
                                                   FontSize="20"
                                                   BackgroundColor="{DynamicResource Primary}"
                                                   TextColor="White"
                                                   BindingContext="{Binding UserId}"
                                                   Clicked="OnSuperLikeClicked"
                                                   CornerRadius="15" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:DiscoveryViewModel}}, Path=ViewUserProfileCommand}"
                                                        CommandParameter="{Binding UserId}" />
                                </Border.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty State -->
                <StackLayout IsVisible="{Binding IsEmpty}"
                           VerticalOptions="Center"
                           Margin="0,50">
                    <Label Text="🔍"
                          FontSize="48"
                          HorizontalOptions="Center"
                          TextColor="{DynamicResource Gray400}" />
                    
                    <Label Text="暂无新的用户"
                          FontSize="18"
                          HorizontalOptions="Center"
                          TextColor="{DynamicResource Gray600}"
                          Margin="0,10" />
                    
                    <Label Text="请稍后再来看看"
                          FontSize="14"
                          HorizontalOptions="Center"
                          TextColor="{DynamicResource Gray500}" />
                    
                    <Button Text="刷新"
                           Command="{Binding RefreshCommand}"
                           BackgroundColor="{DynamicResource Primary}"
                           TextColor="White"
                           Margin="0,20"
                           HorizontalOptions="Center"
                           WidthRequest="120" />
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Filter Bar -->
        <Border Grid.Row="2"
               BackgroundColor="{DynamicResource Gray100}"
               Padding="20,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Text="筛选"
                       Command="{Binding ShowFiltersCommand}"
                       BackgroundColor="Transparent"
                       TextColor="{DynamicResource Primary}"
                       FontSize="16" />
                
                <Label Grid.Column="1"
                      Text="{Binding FilterSummary}"
                      FontSize="14"
                      TextColor="{DynamicResource Gray600}"
                      VerticalOptions="Center" />
                
                <Button Grid.Column="2"
                       Text="设置"
                       Command="{Binding ShowSettingsCommand}"
                       BackgroundColor="Transparent"
                       TextColor="{DynamicResource Primary}"
                       FontSize="16"
                       HorizontalOptions="End" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
