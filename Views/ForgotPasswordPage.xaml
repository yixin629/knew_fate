<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.ForgotPasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KnewFate.ViewModels"
             xmlns:local="clr-namespace:KnewFate.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ForgotPassword]}"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="{DynamicResource Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="40,60,40,20">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Image Source="logo.png" 
                       WidthRequest="120" 
                       HeightRequest="120"
                       Margin="0,0,0,20" />
                
                <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ResetPassword]}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="Enter your email to reset password"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </StackLayout>
        </Grid>

        <!-- Reset Form Section -->
        <Border Grid.Row="1" 
                BackgroundColor="White"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            
            <ScrollView Padding="40,40,40,20">
                <StackLayout Spacing="25">
                    
                    <!-- Instructions -->
                    <StackLayout Spacing="10" Margin="0,0,0,20">
                        <Label Text="Reset Your Password"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}"
                               HorizontalOptions="Center" />
                        
                        <Label Text="We'll send you an email with instructions to reset your password."
                               FontSize="14"
                               TextColor="{DynamicResource Gray600}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </StackLayout>

                    <!-- Email Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Email]}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            
                            <Entry Text="{Binding Email}"
                                   Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterEmail]}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   FontSize="16">
                                <Entry.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                        EventName="TextChanged" 
                                        Command="{Binding ValidateCommand}" />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                        
                        <Label Text="{Binding EmailError}"
                               TextColor="Red"
                               FontSize="12"
                               IsVisible="{Binding HasEmailError}" />
                    </StackLayout>

                    <!-- Send Reset Button -->
                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[SendResetLink]}"
                            Command="{Binding SendResetCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Margin="0,20,0,0"
                            CornerRadius="12"
                            IsEnabled="{Binding IsNotLoading}">
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{DynamicResource Primary}"
                                       Margin="0,15,0,0" />

                    <!-- Success Message -->
                    <Border BackgroundColor="#E8F5E8"
                            Padding="15"
                            IsVisible="{Binding IsSuccess}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="✅"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[PasswordResetEmailSent]}"
                                   TextColor="#2E7D32"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   HorizontalOptions="FillAndExpand" />
                        </StackLayout>
                    </Border>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="14"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasError}"
                           Margin="0,10,0,0" />

                    <!-- Back to Login Link -->
                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[BackToLogin]}"
                            Command="{Binding BackToLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource Primary}"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,30,0,0"
                            HorizontalOptions="Center" />

                </StackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
