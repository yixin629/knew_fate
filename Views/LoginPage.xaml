<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KnewFate.ViewModels"
             xmlns:local="clr-namespace:KnewFate.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Login]}"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="{DynamicResource Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="40,60,40,20">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Image Source="logo.png" 
                       WidthRequest="120" 
                       HeightRequest="120"
                       Margin="0,0,0,20" />
                
                <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[WelcomeBack]}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="KnewFate"
                       FontSize="18"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <!-- Login Form Section -->
        <Border Grid.Row="1" 
                BackgroundColor="White"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            
            <ScrollView Padding="40,40,40,20">
                <StackLayout Spacing="20">
                    
                    <!-- Email Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Email]}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            
                            <Entry x:Name="EmailEntry"
                                   Text="{Binding Email}"
                                   Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterEmail]}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   FontSize="16">
                                <Entry.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                        EventName="TextChanged" 
                                        Command="{Binding ValidateCommand}" />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                        
                        <Label Text="{Binding EmailError}"
                               TextColor="Red"
                               FontSize="12"
                               IsVisible="{Binding HasEmailError}" />
                    </StackLayout>

                    <!-- Password Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Password]}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Text="{Binding Password}"
                                       Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterPassword]}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       BackgroundColor="Transparent"
                                       FontSize="16">
                                    <Entry.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="TextChanged" 
                                            Command="{Binding ValidateCommand}" />
                                    </Entry.Behaviors>
                                </Entry>
                                
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Gray600}"
                                        FontSize="16"
                                        Padding="10,0"
                                        WidthRequest="40" />
                            </Grid>
                        </Border>
                        
                        <Label Text="{Binding PasswordError}"
                               TextColor="Red"
                               FontSize="12"
                               IsVisible="{Binding HasPasswordError}" />
                    </StackLayout>

                    <!-- Remember Me & Forgot Password -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <CheckBox x:Name="RememberMeCheckBox"
                                      IsChecked="{Binding RememberMe}"
                                      Color="{DynamicResource Primary}" />
                            <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[RememberMe]}"
                                   FontSize="14"
                                   TextColor="{DynamicResource Gray700}"
                                   VerticalOptions="Center" />
                        </StackLayout>
                        
                        <Button Grid.Column="1"
                                Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ForgotPassword]}"
                                Command="{Binding ForgotPasswordCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Primary}"
                                FontSize="14"
                                Padding="0" />
                    </Grid>

                    <!-- Login Button -->
                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[SignIn]}"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Margin="0,20,0,0"
                            CornerRadius="12"
                            IsEnabled="{Binding IsNotLoading}">
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{DynamicResource Primary}"
                                       Margin="0,10,0,0" />

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="14"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasError}"
                           Margin="0,10,0,0" />

                    <!-- Sign Up Link -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center"
                                 Spacing="5"
                                 Margin="0,30,0,0">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[DontHaveAccount]}"
                               FontSize="14"
                               TextColor="{DynamicResource Gray700}" />
                        
                        <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[SignUp]}"
                                Command="{Binding NavigateToRegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Primary}"
                                FontSize="14"
                                FontAttributes="Bold"
                                Padding="0" />
                    </StackLayout>

                </StackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
