<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.PremiumPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Premium">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20" Spacing="20">
                <Label Text="Premium Features"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                
                <Label Text="Unlock advanced features..."
                       FontSize="16"
                       HorizontalOptions="Center" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
