<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KnewFate.Views.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KnewFate.ViewModels"
             xmlns:local="clr-namespace:KnewFate.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:RegisterViewModel"
             Title="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Register]}"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="{DynamicResource Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="2.3*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Padding="40,60,40,20">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Image Source="logo.png" 
                       WidthRequest="100" 
                       HeightRequest="100"
                       Margin="0,0,0,15" />
                
                <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[CreateAccount]}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="Join KnewFate Today"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center" />
            </StackLayout>
        </Grid>

        <!-- Registration Form Section -->
        <Border Grid.Row="1" 
                BackgroundColor="White"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>
            
            <ScrollView Padding="40,30,40,20">
                <StackLayout Spacing="20">
                    
                    <!-- Name Fields -->
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- First Name -->
                        <StackLayout Grid.Column="0" Spacing="8">
                            <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[FirstName]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Gray900}" />
                            
                            <Border BackgroundColor="{DynamicResource Gray100}"
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                                <Entry Text="{Binding FirstName}"
                                       Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterFirstName]}"
                                       BackgroundColor="Transparent"
                                       FontSize="15">
                                    <Entry.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="TextChanged" 
                                            Command="{Binding ValidateCommand}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Border>
                            
                            <Label Text="{Binding FirstNameError}"
                                   TextColor="Red"
                                   FontSize="11"
                                   IsVisible="{Binding HasFirstNameError}" />
                        </StackLayout>
                        
                        <!-- Last Name -->
                        <StackLayout Grid.Column="1" Spacing="8">
                            <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[LastName]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource Gray900}" />
                            
                            <Border BackgroundColor="{DynamicResource Gray100}"
                                    Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                                <Entry Text="{Binding LastName}"
                                       Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterLastName]}"
                                       BackgroundColor="Transparent"
                                       FontSize="15">
                                    <Entry.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="TextChanged" 
                                            Command="{Binding ValidateCommand}" />
                                    </Entry.Behaviors>
                                </Entry>
                            </Border>
                            
                            <Label Text="{Binding LastNameError}"
                                   TextColor="Red"
                                   FontSize="11"
                                   IsVisible="{Binding HasLastNameError}" />
                        </StackLayout>
                    </Grid>

                    <!-- Email Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Email]}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            
                            <Entry Text="{Binding Email}"
                                   Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterEmail]}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   FontSize="15">
                                <Entry.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                        EventName="TextChanged" 
                                        Command="{Binding ValidateCommand}" />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                        
                        <Label Text="{Binding EmailError}"
                               TextColor="Red"
                               FontSize="11"
                               IsVisible="{Binding HasEmailError}" />
                    </StackLayout>

                    <!-- Password Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Password]}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Entry Grid.Column="0"
                                       Text="{Binding Password}"
                                       Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[EnterPassword]}"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       BackgroundColor="Transparent"
                                       FontSize="15">
                                    <Entry.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="TextChanged" 
                                            Command="{Binding ValidateCommand}" />
                                    </Entry.Behaviors>
                                </Entry>
                                
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Gray600}"
                                        FontSize="14"
                                        Padding="8,0"
                                        WidthRequest="35" />
                            </Grid>
                        </Border>
                        
                        <Label Text="{Binding PasswordError}"
                               TextColor="Red"
                               FontSize="11"
                               IsVisible="{Binding HasPasswordError}" />
                    </StackLayout>

                    <!-- Confirm Password Entry -->
                    <StackLayout Spacing="8">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ConfirmPassword]}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Gray900}" />
                        
                        <Border BackgroundColor="{DynamicResource Gray100}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <Entry Grid.Column="0"
                                       Text="{Binding ConfirmPassword}"
                                       Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ConfirmPassword]}"
                                       IsPassword="{Binding IsConfirmPasswordHidden}"
                                       BackgroundColor="Transparent"
                                       FontSize="15">
                                    <Entry.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="TextChanged" 
                                            Command="{Binding ValidateCommand}" />
                                    </Entry.Behaviors>
                                </Entry>
                                
                                <Button Grid.Column="1"
                                        Text="{Binding ConfirmPasswordToggleIcon}"
                                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Gray600}"
                                        FontSize="14"
                                        Padding="8,0"
                                        WidthRequest="35" />
                            </Grid>
                        </Border>
                        
                        <Label Text="{Binding ConfirmPasswordError}"
                               TextColor="Red"
                               FontSize="11"
                               IsVisible="{Binding HasConfirmPasswordError}" />
                    </StackLayout>

                    <!-- Register Button -->
                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[CreateAccount]}"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="{DynamicResource Primary}"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Margin="0,15,0,0"
                            CornerRadius="10"
                            IsEnabled="{Binding IsNotLoading}">
                    </Button>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{DynamicResource Primary}"
                                       Margin="0,10,0,0" />

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="12"
                           HorizontalOptions="Center"
                           IsVisible="{Binding HasError}"
                           Margin="0,10,0,0" />

                    <!-- Sign In Link -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center"
                                 Spacing="5"
                                 Margin="0,20,0,0">
                        <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[AlreadyHaveAccount]}"
                               FontSize="14"
                               TextColor="{DynamicResource Gray700}" />
                        
                        <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[SignIn]}"
                                Command="{Binding NavigateToLoginCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Primary}"
                                FontSize="14"
                                FontAttributes="Bold"
                                Padding="0" />
                    </StackLayout>

                </StackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
