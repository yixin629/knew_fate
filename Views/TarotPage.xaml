<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KnewFate.Views"
             xmlns:converters="clr-namespace:KnewFate.Converters"
             x:Class="KnewFate.Views.TarotPage"
             Title="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Tarot]}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TarotSuitToColorConverter x:Key="SuitToColorConverter" />
            <converters:BooleanInverterConverter x:Key="BooleanInverterConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <!-- Tarot Reading Header -->
            <Frame Style="{StaticResource MysticFrame}">
                <StackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[Tarot]}"
                           Style="{StaticResource MysticTitle}"/>
                    <Label Text="Discover insights through the ancient wisdom of Tarot"
                           Style="{StaticResource CardSubtitle}"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- Quick Draw Section -->
            <Frame Style="{StaticResource CardFrame}">
                <StackLayout Spacing="15">
                    <Label Text="Quick Reading"
                           Style="{StaticResource CardTitle}"/>
                    
                    <Entry Text="{Binding Question}"
                           Placeholder="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[YourQuestion]}"
                           IsVisible="{Binding ShowQuestionInput}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Single Card"
                                Command="{Binding DrawSingleCardCommand}"
                                BackgroundColor="{StaticResource Mystic}"/>
                        
                        <Button Grid.Column="1"
                                Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[ThreeCardSpread]}"
                                Command="{Binding DrawThreeCardCommand}"
                                BackgroundColor="{StaticResource Fortune}"/>
                    </Grid>

                    <Button Text="{Binding Source={x:Static local:LocalizationHelper.Instance}, Path=[CelticCross]}"
                            Command="{Binding DrawCelticCrossCommand}"
                            BackgroundColor="{StaticResource Destiny}"/>
                </StackLayout>
            </Frame>

            <!-- Current Reading Results -->
            <Frame Style="{StaticResource CardFrame}"
                   IsVisible="{Binding HasCurrentReading}">
                <StackLayout Spacing="15">
                    <Label Text="Your Reading"
                           Style="{StaticResource CardTitle}"/>
                    
                    <Label Text="{Binding CurrentReading.Question}"
                           Style="{StaticResource CardSubtitle}"
                           IsVisible="{Binding CurrentReading.Question, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

                    <Label Text="{Binding CurrentReading.SpreadType}"
                           FontSize="14"
                           FontAttributes="Italic"
                           TextColor="{StaticResource Gray500}"/>

                    <!-- Cards Display -->
                    <CollectionView ItemsSource="{Binding CurrentReading.Cards}"
                                    BackgroundColor="Transparent">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" 
                                           Span="{Binding CardsPerRow}" 
                                           HorizontalItemSpacing="10"
                                           VerticalItemSpacing="15"/>
                        </CollectionView.ItemsLayout>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Style="{StaticResource TarotCardFrame}"
                                       BackgroundColor="{Binding Suit, Converter={StaticResource SuitToColorConverter}}"
                                       WidthRequest="120"
                                       HeightRequest="180">
                                    <StackLayout Spacing="5">
                                        <Label Text="{Binding Position}"
                                               FontSize="10"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                        
                                        <Image Source="{Binding ImagePath}"
                                               WidthRequest="80"
                                               HeightRequest="120"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Center"/>
                                        
                                        <Label Text="{Binding Name}"
                                               FontSize="12"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"/>
                                        
                                        <Label Text="{Binding IsReversed, StringFormat='({0})'}"
                                               FontSize="10"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding IsReversed}"/>
                                    </StackLayout>
                                    
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:TarotPage}}, Path=BindingContext.ShowCardDetailsCommand}"
                                                              CommandParameter="{Binding}"/>
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Interpretation -->
                    <Frame BackgroundColor="{StaticResource Gray100}"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="False"
                           IsVisible="{Binding ShowInterpretation}">
                        <StackLayout>
                            <Label Text="Interpretation"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   Margin="0,0,0,10"/>
                            
                            <Label Text="{Binding CurrentReading.Interpretation}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Frame>

                    <Button Text="Save Reading"
                            Command="{Binding SaveReadingCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackLayout>
            </Frame>

            <!-- Reading History -->
            <Frame Style="{StaticResource CardFrame}"
                   IsVisible="{Binding ReadingHistory, Converter={StaticResource ListCountToVisibilityConverter}}">
                <StackLayout Spacing="15">
                    <Label Text="Recent Readings"
                           Style="{StaticResource CardTitle}"/>

                    <CollectionView ItemsSource="{Binding ReadingHistory}"
                                    BackgroundColor="Transparent"
                                    MaximumHeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,5,0,10">
                                    <Frame BackgroundColor="{StaticResource Gray100}"
                                           CornerRadius="10"
                                           Padding="15"
                                           HasShadow="False">
                                        <StackLayout>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding SpreadType}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat='{0:MMM dd}'}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}"/>
                                            </Grid>
                                            
                                            <Label Text="{Binding Question}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Gray600}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   Margin="0,5,0,0"
                                                   IsVisible="{Binding Question, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                        </StackLayout>
                                        
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:TarotPage}}, Path=BindingContext.LoadReadingCommand}"
                                                                  CommandParameter="{Binding}"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

        </StackLayout>
    </ScrollView>

</ContentPage>
